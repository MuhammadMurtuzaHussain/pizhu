# Where Gemma runs: "ollama" (local, private — default) or "google" (Google AI Studio, for the hosted demo)
MODEL_PROVIDER=ollama

# Local Gemma via Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/api
OLLAMA_MODEL=gemma4:e4b

# Hosted Gemma via Google AI Studio (free tier) — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemma-4-31b-it

# Reference checker — https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# How many paragraphs to analyse at once (keep 1 for a laptop running Ollama)
ANALYZE_CONCURRENCY=1
# Word cap per request (set on the hosted demo)
MAX_WORDS=
